APP_NAME=CIVILIZE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=https://civilizerestaurant.id.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civilize
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=civilize_

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@civilizerestaurant.id.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Cấu hình thanh toán VietQR & Webhook Ngân hàng tự động (Sepay / Casso)
PAYMENT_MODE=production
PAYMENT_WEBHOOK_TOKEN=
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_BANK_ID=

# Trợ lý AI Chatbot Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Chế độ chạy migration qua route /admin/system-migrate khi triển khai trên hosting (mặc định tắt)
ALLOW_SYSTEM_MIGRATE=false

